{
  "name": "rumia",
  "version": "1.26.2",
  "description": "Desktop Pet AI",
  "main": "main.js",
  "scripts": {
    "start": "electron . --enable-logging",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mystiafly.rumiapet",
    "productName": "Rumia Desktop Pet",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "大贤者桌宠 (Touhou Pet)"
    },
    "asar": false,
    "directories": {
      "output": "dist/installer"
    },
    "extraFiles": [
      {
        "from": ".node_env",
        "to": ".node_env"
      },
      {
        "from": "dist/backend",
        "to": "dist/backend"
      }
    ],
    "files": [
      "**/*",
      "!.venv",
      "!**/qdrant_db",
      "!**/*.log",
      "!**/*.db",
      "!__pycache__",
      "!.node_env",
      "!.vscode",
      "!.idea",
      "!dist",
      "!build",
      "!*.zip"
    ]
  }
}