@echo off
chcp 65001 >nul
echo =======================================================
echo              Rumia 自动化测试运行器
echo =======================================================
echo.
echo [警告] 运行测试前，请确保您已经关闭了“东方桌宠”本体程序！
echo 因为测试程序需要加载记忆数据库，如果桌宠同时在运行，
echo 会导致数据库被锁定，测试将卡住无法完成。
echo.
echo 准备就绪后，按任意键开始运行测试...
pause >nul

echo.
echo [INFO] 正在启动 pytest...
echo.

pytest -v -s

echo.
echo =======================================================
echo 测试执行完毕。
pause
